<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dynamics Reporting App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/output.css" />
</head>
<body class="bg-gray-100 font-sans">
    <!-- Header -->
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <h1 class="text-xl font-semibold text-gray-800">
                    @ViewData["Title"]
                </h1>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-600">User Login</span>
                    <button class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-user-circle text-xl"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside class="w-64 bg-white shadow-sm border-r border-gray-200 fixed left-0 top-16 bottom-0 overflow-y-auto">
            <div class="p-4">
                <!-- Menu Section -->
                <div class="mb-8">
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Menu</h2>
                    <ul class="space-y-2">
                        <li>
                            <a href="@Url.Action("Index", "Group")"
                               class="flex items-center px-3 py-2 text-gray-700 rounded-md hover:bg-gray-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Group" ? "bg-blue-50 text-blue-700 border-r-2 border-blue-500" : "")">
                                <i class="fas fa-users mr-3"></i>
                                Group Report
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Settings Section -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-800 mb-4">Settings</h2>
                    <ul class="space-y-2">
                        <li>
                            <a href="@Url.Action("Index", "User")"
                               class="flex items-center px-3 py-2 text-gray-700 rounded-md hover:bg-gray-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "bg-blue-50 text-blue-700 border-r-2 border-blue-500" : "")">
                                <i class="fas fa-user mr-3"></i>
                                User
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "GroupReport")"
                               class="flex items-center px-3 py-2 text-gray-700 rounded-md hover:bg-gray-100 @(ViewContext.RouteData.Values["controller"]?.ToString() == "GroupReport" ? "bg-blue-50 text-blue-700 border-r-2 border-blue-500" : "")">
                                <i class="fas fa-chart-bar mr-3"></i>
                                Group Report
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 ml-64 mt-16 overflow-y-auto">
            <div class="p-6">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Footer -->
    <footer class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-2">
        <div class="text-center text-sm text-gray-500">
            แสดง Group Report ตาม สิทธิ์ ของ User Login
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>