<!DOCTYPE html>
<html lang="th" class="h-100">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Dynamics Reporting App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .sidebar {
            min-height: calc(100vh - 60px);
            position: sticky;
            top: 60px;
        }

        .main-content {
            min-height: calc(100vh - 120px);
        }

        .navbar {
            height: 60px;
        }

        .footer {
            height: 60px;
            margin-top: auto;
        }

        /* Remove default margins and paddings for full screen */
        .container-fluid {
            padding: 0;
        }

        .row {
            margin: 0;
        }

        /* Scrollable sidebar if content is too long */
        .sidebar {
            overflow-y: auto;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm fixed-top">
        <div class="container-fluid px-3">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fas fa-chart-bar me-2 text-primary"></i>
                Dynamics Reporting
            </a>
            <div class="d-flex align-items-center">
                <span class="me-3 text-muted">
                    <i class="fas fa-user me-1"></i>
                    @ViewBag.Username
                </span>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="fas fa-user-cog me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Authen" asp-action="Logout">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <div class="container-fluid flex-grow-1" style="margin-top: 60px;">
        <div class="row h-100">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 bg-light border-end p-0 sidebar">
                @await Html.PartialAsync("_Sidebar")
            </div>

            <!-- Main Content -->
            <main role="main" class="col-md-9 col-lg-10 p-0 main-content">
                <div class="h-100 p-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer bg-light border-top text-center small py-2">
        <div class="container-fluid">
            <span class="text-muted">
                © @DateTime.Now.Year Dynamics Reporting App. All rights reserved.
            </span>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>