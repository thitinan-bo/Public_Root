@using DynamicsReporting.Models
@model ResponseDataModel<ReportConfigModel>

@{
    ViewData["Title"] = "Report Viewer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Report Config</h5>
        <input type="hidden" name="reportId"
               value="@(Model?.Data?.ReportProcs?.FirstOrDefault()?.ReportId ?? 0)" />
    </div>

    <div class="card-body">
        <!-- Stored Procedures -->
        @if (Model?.Data?.ReportProcs != null && Model.Data.ReportProcs.Any())
        {
            <h6 class="fw-bold">Stored Procedures</h6>
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Proc ID</th>
                        <th>Server</th>
                        <th>Database</th>
                        <th>Stored Procedure</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proc in Model.Data.ReportProcs)
                    {
                        <tr>
                            <td>@proc.ReportProcId</td>
                            <td>@proc.ServerName</td>
                            <td>@proc.DatabaseName</td>
                            <td><code>@proc.StoredProcedure</code></td>
                        </tr>
                        <!-- ซ่อน ReportId แต่ละ Proc -->
                        <input type="hidden" name="reportIds" value="@proc.ReportId" />
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-warning">ไม่พบ Stored Procedures</div>
        }

        <!-- Parameters -->
        <form id="executeReportForm">
            @if (Model?.Data?.ReportParams != null && Model.Data.ReportParams.Any())
            {
                <h6 class="fw-bold mt-3">Parameters</h6>
                <div class="row">
                    @foreach (var param in Model.Data.ReportParams)
                    {
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@param.ParameterName</label>
                            <input type="text"
                                   class="form-control"
                                   name="parameters[@param.ParameterName]"
                                   placeholder="@param.ParameterDbType" />
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">ไม่พบ Parameters</div>
            }

            <button type="button" id="btnLoadReport" class="btn btn-success mt-2">
                <i class="fas fa-play"></i> Execute Report
            </button>
        </form>

        <hr />

        <!-- Dynamic Table -->
        <table id="reportTable" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr id="reportHeader"></tr>
            </thead>
        </table>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script>
        var reportTable = null; // ✅ ประกาศเป็น global variable

        $("#btnLoadReport").click(function () {
            var formData = $("#executeReportForm").serializeArray();
            var reportId = parseInt($("input[name='reportId']").val()) || 0;

            var params = {};
            formData.forEach(function (item) {
                if (item.name.startsWith("parameters[")) {
                    var key = item.name.replace("parameters[", "").replace("]", "");
                    params[key] = item.value;
                }
            });

            var request = {
                reportId: reportId,
                parameters: params
            };

            // ✅ เช็คก่อนว่าเคยสร้าง DataTable แล้วหรือยัง
            if (reportTable !== null) {
                reportTable.destroy();
                $("#reportTable thead tr").empty();
                reportTable = null;
            }

            $.ajax({
                url: '@Url.Action("ExecuteReport", "Report")',
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify(request),
                success: function (res) {
                    if (res.success && res.data.length > 0) {
                        var columns = Object.keys(res.data[0]).map(x => ({ data: x, title: x }));

                        columns.forEach(c => {
                            $("#reportHeader").append("<th>" + c.title + "</th>");
                        });

                        reportTable = $("#reportTable").DataTable({
                            serverSide: false,
                            processing: true,
                            data: res.data,
                            columns: columns,
                            dom: 'Bfrtip',
                            buttons: [
                                { extend: 'excelHtml5', text: 'Export Excel' }
                            ]
                        });
                    } else {
                        $("#reportHeader").html("<th>No data</th>");
                    }
                },
                error: function () {
                    $("#reportHeader").html("<th class='text-danger'>Error loading data</th>");
                }
            });
        });
    </script>
}
