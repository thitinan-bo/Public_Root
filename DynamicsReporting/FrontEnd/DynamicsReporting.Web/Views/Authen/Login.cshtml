@using DynamicsReporting.Models.Authen
@model DynamicsReporting.Models.Authen.AuthenRequestModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="text-center mb-4">
    <img src="~/images/logo.png" class="img-fluid mb-3" alt="Logo" style="max-height: 80px;" />
    <h2 class="fw-bold">Login</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Login" method="post">
            <!-- Username -->
            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" value="thitinan" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Branch -->
            <div class="mb-3">
                <label asp-for="BranchCode" class="form-label">Branch</label>
                <select asp-for="BranchCode" asp-items="ViewBag.Branches" class="form-select">
                    <option value="">-- Select Branch --</option>
                </select>
                <span asp-validation-for="BranchCode" class="text-danger small"></span>
            </div>

            <!-- Submit Button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt me-1"></i> Login
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
