@using DynamicsReporting.Models
@using DynamicsReporting.Models.Authen
@model ResponseDataModel<PaginatedResult<GroupReportUseModel>>

@{
    ViewData["Title"] = "Group Report";
    Layout = "~/Views/Shared/_Layout.cshtml"; // ✅ เปลี่ยนให้ถูก path
}

<div class="bg-white rounded-lg shadow-sm">
    <!-- Content Header -->
    <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800">Group Report</h2>
    </div>

    <!-- Table Container -->
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-r border-gray-200">ลำดับ</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-r border-gray-200">Group Report</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model?.Data?.Data != null && Model.Data.Data.Any())
                {
                    var index = 1;
                    foreach (var item in Model.Data.Data)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 border-r border-gray-200">@index</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 border-r border-gray-200">@item.GroupName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <a asp-controller="Report" asp-action="Index" asp-route-groupId="@item.GroupID"
                                   class="inline-flex items-center text-blue-600 hover:text-blue-800 text-sm">
                                    <i class="fas fa-link mr-1"></i>
                                    Click to Report
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-6 py-4 text-center text-gray-500">ไม่พบข้อมูล</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model?.Data?.Pagination != null)
    {
        <div class="px-6 py-4 border-t border-gray-200">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500">
                    Page @Model.Data.Pagination.CurrentPage of @Model.Data.Pagination.TotalPages
                </div>
                <div class="flex space-x-1">
                    <a asp-action="Index" asp-route-page="@(Model.Data.Pagination.CurrentPage - 1)" asp-route-pageSize="@Model.Data.Pagination.PageSize"
                       class="px-3 py-1 text-sm border border-gray-300 rounded hover:bg-gray-50 @(Model.Data.Pagination.CurrentPage <= 1 ? "opacity-50 pointer-events-none" : "")">
                        Previous
                    </a>
                    @for (int i = 1; i <= Model.Data.Pagination.TotalPages; i++)
                    {
                        <a asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.Data.Pagination.PageSize"
                           class="px-3 py-1 text-sm rounded @(i == Model.Data.Pagination.CurrentPage ? "bg-blue-500 text-white" : "border border-gray-300 hover:bg-gray-50")">
                            @i
                        </a>
                    }
                    <a asp-action="Index" asp-route-page="@(Model.Data.Pagination.CurrentPage + 1)" asp-route-pageSize="@Model.Data.Pagination.PageSize"
                       class="px-3 py-1 text-sm border border-gray-300 rounded hover:bg-gray-50 @(Model.Data.Pagination.CurrentPage >= Model.Data.Pagination.TotalPages ? "opacity-50 pointer-events-none" : "")">
                        Next
                    </a>
                </div>
            </div>
        </div>
    }
</div>
